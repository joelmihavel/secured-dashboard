{
  "mcpServers": {
    "XcodeBuildMCP": {
      "command": "/Users/atrishabh/.npm-global/bin/xcodebuildmcp",
      "args": []
    },
    "maestro": {
      "command": "/bin/bash",
      "args": ["-c", "export JAVA_HOME=/opt/homebrew/opt/openjdk@17/libexec/openjdk.jdk/Contents/Home && export PATH=$JAVA_HOME/bin:$PATH && /Users/atrishabh/.maestro/bin/maestro mcp"]
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"]
    },
    "cloudflare": {
      "command": "npx",
      "args": ["-y", "mcp-remote", "https://api.mcp.cloudflare.com/mcp"]
    },
    "cloudflare-bindings": {
      "command": "npx",
      "args": ["-y", "mcp-remote", "https://bindings.mcp.cloudflare.com/mcp"]
    },
    "cloudflare-observability": {
      "command": "npx",
      "args": ["-y", "mcp-remote", "https://observability.mcp.cloudflare.com/mcp"]
    }
  }
