{
  "mcpServers": {
    "maestro": {
      "command": "/bin/bash",
      "args": [
        "-c",
        "export JAVA_HOME=/opt/homebrew/opt/openjdk@17/libexec/openjdk.jdk/Contents/Home && export PATH=$JAVA_HOME/bin:$PATH && /Users/atrishabh/.maestro/bin/maestro mcp"
      ]
    },
    "cashfree": {
      "command": "node",
      "args": [
        "/Users/atrishabh/Documents/Dev/cashfree-mcp/dist/index.js"
      ],
      "env": {
        "PAYMENTS_APP_ID": "${CASHFREE_PG_APP_ID}",
        "PAYMENTS_APP_SECRET": "${CASHFREE_PG_APP_SECRET}",
        "TOOLS": "pg",
        "ENV": "production"
      }
    }
  }
}
