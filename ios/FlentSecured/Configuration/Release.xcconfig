// Release.xcconfig
// Flent Secured v2 - Release Build Configuration
//
// IMPORTANT: Production secrets should be injected via CI/CD
// Never commit actual keys to this file

// Supabase Configuration
SUPABASE_URL = https:/$()/uowjtrzmszuaiokqxgir.supabase.co
SUPABASE_ANON_KEY =

// PayU Configuration (Production)
PAYU_MERCHANT_KEY =
