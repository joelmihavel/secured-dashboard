# rn-app/.env.local — local override config (gitignored)
#
# This file is auto-generated by scripts/dev-up.sh when you run `npm run dev:up`
# from the repo root. The script writes a fresh copy each invocation, so any
# manual edits here will be overwritten. To persist personal overrides, set
# them in your shell environment instead:
#
#   export EXPO_PUBLIC_USE_OTP_ROUTING=true
#
# Expo's load order for .env files: .env.local > .env.{development,production}.local
# > .env.{development,production} > .env. So this file always wins.

APP_ENV=development

# Local Supabase URL — 127.0.0.1 by default. WITH_LAN_ACCESS=1 in dev-up.sh
# replaces with your machine's LAN IP for physical-device testing.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Local anon key (auto-generated by `supabase start`; copy from `supabase status` output)
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6IjEyM3Rlc3QiLCJyb2xlIjoiYW5vbiJ9.local-anon-key-replace-me

EXPO_PUBLIC_PAYMENT_GATEWAY=cashfree
EXPO_PUBLIC_CASHFREE_ENV=SANDBOX

# Local doesn't have Twilio creds → OTP routing disabled (fall back to demo OTP "123456")
EXPO_PUBLIC_USE_OTP_ROUTING=false
