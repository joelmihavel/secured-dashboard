                                "top": 0,
                              },
                              {
                                "opacity": 1,
                              },
                            ]
                          }
                        />
                        <View
                          pointerEvents="none"
                          style={
                            [
                              {
                                "bottom": 0,
                                "left": 0,
                                "position": "absolute",
                                "right": 0,
                                "top": 0,
                              },
                              {
                                "opacity": 0,
                              },
                            ]
                          }
                        >
                          <View
                            style={
                              {
                                "borderColor": "rgba(0,0,0,0.6)",
                                "borderCurve": "continuous",
                                "borderLeftWidth": 1,
                                "borderRadius": 8,
                                "borderRightWidth": 1,
                                "borderTopWidth": 2,
                                "bottom": 0,
                                "left": 0,
                                "position": "absolute",
                                "right": 0,
                                "top": 0,
                              }
                            }
                          />
                          <LinearGradient
                            colors={
                              [
                                "rgba(0,0,0,0.8)",
                                "transparent",
                              ]
                            }
                            end={
                              {
                                "x": 0,
                                "y": 1,
                              }
                            }
                            start={
                              {
                                "x": 0,
                                "y": 0,
                              }
                            }
                            style={
                              {
                                "borderTopLeftRadius": 8,
                                "borderTopRightRadius": 8,
                                "height": 16,
                                "width": "100%",
                              }
                            }
                          />
                        </View>
                        <Text
                          style={
                            {
                              "color": "#FFFFFF",
                              "fontFamily": "PlusJakartaSans-Medium",
                              "fontSize": 16,
                              "lineHeight": 24,
                              "textAlign": "center",
                            }
                          }
                        >
                          Save Changes
                        </Text>
                      </View>
                    </View>
                  </View>
                </View>
              </View>
            </View>
          </View>
        </RCTScrollView>
