# Supabase Configuration
# Get these from your Supabase project dashboard
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# PayU Configuration (client-side key only — retained for coexistence)
# IMPORTANT: Never store PAYU_SALT here - it must only be in Supabase Edge Functions
EXPO_PUBLIC_PAYU_KEY=your-payu-merchant-key

# Cashfree Configuration (client-side env flag only)
# SANDBOX or PRODUCTION — determines which Cashfree environment the SDK targets
EXPO_PUBLIC_CASHFREE_ENV=SANDBOX
