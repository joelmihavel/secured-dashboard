# Supabase Configuration
# Dev/Preview: use branch URL (zqlow...), Production: use main URL (uowjt...)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Payment Gateway Selection
# 'cashfree' for new builds, 'payu' for legacy (or omit for PayU default)
EXPO_PUBLIC_PAYMENT_GATEWAY=cashfree

# PayU Configuration (client-side key only)
# IMPORTANT: Never store PAYU_SALT here — it must only be in Supabase Edge Functions
EXPO_PUBLIC_PAYU_KEY=your-payu-merchant-key

# Cashfree Configuration
# SANDBOX for dev/preview, PRODUCTION for production
EXPO_PUBLIC_CASHFREE_ENV=SANDBOX

# OTP Routing — routes auth through auth-otp edge function (Twilio/Cashfree M360)
EXPO_PUBLIC_USE_OTP_ROUTING=true


# EAS CLI Token (for CI/CD, not needed locally)
# EXPO_TOKEN=your-eas-token
