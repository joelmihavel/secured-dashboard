+    /// Dismiss the Custom Browser webview after a terminal event (success/failure/cancel).
+    /// Handles both modal presentation and navigation controller push.
+    private func dismissWebVC() {
+        DispatchQueue.main.async { [weak self] in
+            guard let webVC = self?.webVC else { return }
+            if let nav = webVC.navigationController {
+                nav.popViewController(animated: true)
+            } else {
+                webVC.dismiss(animated: true)
+            }
+            self?.webVC = nil
+        }
+    }
