# supabase/.env.local — local edge-function secrets (gitignored)
#
# Copy this to supabase/.env.local and fill in your own test/sandbox credentials.
# The dev-up.sh script passes this file to `supabase functions serve --env-file`.
#
# Anything left blank means that code path will fail locally. That's usually fine —
# you only need keys for the flows you're actively developing.

# ─── Cashfree (sandbox — no real money) ───────────────────────────────────────
# Get from https://merchant.cashfree.com/merchants/sandbox
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_BASE_URL=https://sandbox.cashfree.com/verification
CASHFREE_PUBLIC_KEY=

CASHFREE_PG_APP_ID=
CASHFREE_PG_APP_SECRET=
CASHFREE_PG_BASE_URL=https://sandbox.cashfree.com/pg

# Webhook secret for cashfree-split-webhook (separate from PG secret, see Phase 7e)
CASHFREE_SPLIT_WEBHOOK_SECRET=local-split-webhook-secret-anything

# ─── Twilio (test creds — no real SMS) ────────────────────────────────────────
# Use the test credentials from https://www.twilio.com/console/project/test-credentials
# Test creds simulate sends without actually delivering.
TWILIO_ACCOUNT_SID=ACtest_replace_me
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGE_SERVICE_SID=

# ─── PayU (legacy — only needed if testing legacy payment flows) ──────────────
PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=

# ─── Google APIs ──────────────────────────────────────────────────────────────
# Get a personal Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_API_KEY_SECURED=

# ─── Cloud Run extraction service (local dev) ─────────────────────────────────
# When WITH_EXTRACTION=1 in dev-up.sh, the local extraction service runs at :8080.
# Set this to that URL so the process-document edge function can delegate.
EXTRACTION_SERVICE_URL=http://host.docker.internal:8080
EXTRACTION_SECRET=local-dev-extraction-secret

# Set to 0 to never delegate, 100 to always delegate. Local dev typically: 0 (test in-process path)
CLOUD_RUN_PERCENTAGE=0

# ─── Demo / dev-only gates ────────────────────────────────────────────────────
# When true, allows dev-seed and seed-test-data edge functions to manipulate state.
# Should be true ONLY in local + dev-branch Supabase. NEVER in prod.
ALLOW_DEMO_AUTH=true

# ─── Other ────────────────────────────────────────────────────────────────────
ENCRYPTION_KEY=local-dev-encryption-key-32-chars
ADMIN_API_KEY=local-admin-key-please-rotate
ENVIRONMENT=development

# ─── API Club (utility verification) ──────────────────────────────────────────
API_CLUB_KEY=
API_CLUB_BASE_URL=https://prod.apiclub.in/api/v1
