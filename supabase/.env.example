# Supabase Edge Functions Environment Variables
# These must be set via `supabase secrets set` command
# NEVER commit actual values to version control

# PayU Payment Gateway (REQUIRED)
# Get these from PayU Merchant Dashboard
PAYU_MERCHANT_KEY=your-merchant-key
PAYU_MERCHANT_SALT=your-merchant-salt-KEEP-SECRET
PAYU_BASE_URL=https://sandboxsecure.payu.in

# Twilio SMS (REQUIRED for OTP)
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Google Gemini AI (REQUIRED for document extraction)
GEMINI_API_KEY=your-gemini-api-key

# Cashfree (Optional - for bank verification)
CASHFREE_CLIENT_ID=your-client-id
CASHFREE_CLIENT_SECRET=your-client-secret

# Push Notifications (Optional)
FCM_SERVER_KEY=your-fcm-server-key

# ====================================
# HOW TO SET SECRETS:
# ====================================
# 1. For local development:
#    supabase secrets set --env-file ./supabase/.env.local
#
# 2. For production (Supabase Dashboard):
#    - Go to Project Settings > Edge Functions
#    - Add each secret individually
#
# 3. Via CLI for production:
#    supabase secrets set PAYU_MERCHANT_SALT=your-value --project-ref your-project-ref
