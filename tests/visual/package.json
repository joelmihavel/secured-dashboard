{
  "name": "flent-secured-visual-tests",
  "version": "1.0.0",
  "description": "Visual regression tests for Flent Secured iOS app using Sauce Labs Visual with Figma baselines",
  "main": "index.js",
  "scripts": {
    "test": "wdio run wdio.conf.ts",
    "test:visual": "wdio run wdio.conf.ts --spec ./specs/visual/**/*.spec.ts",
    "test:splash": "wdio run wdio.conf.ts --spec ./specs/visual/splash.spec.ts",
    "test:auth": "wdio run wdio.conf.ts --spec ./specs/visual/auth.spec.ts",
    "test:home": "wdio run wdio.conf.ts --spec ./specs/visual/home.spec.ts",
    "test:payment": "wdio run wdio.conf.ts --spec ./specs/visual/payment.spec.ts",
    "test:profile": "wdio run wdio.conf.ts --spec ./specs/visual/profile.spec.ts",
    "test:all-flows": "wdio run wdio.conf.ts"
  },
  "dependencies": {
    "@saucelabs/visual": "^0.8.0",
    "@wdio/appium-service": "^8.35.0",
    "@wdio/cli": "^8.35.0",
    "@wdio/local-runner": "^8.35.0",
    "@wdio/mocha-framework": "^8.35.0",
    "@wdio/sauce-service": "^8.35.0",
    "@wdio/spec-reporter": "^8.35.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "webdriverio": "^8.35.0"
  },
  "devDependencies": {
    "@saucelabs/wdio-sauce-visual-service": "^0.13.0",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.11.0"
  },
  "keywords": [
    "visual-testing",
    "sauce-labs",
    "figma",
    "ios",
    "appium",
    "flent-secured"
  ],
  "author": "Flent",
  "license": "PRIVATE"
}
