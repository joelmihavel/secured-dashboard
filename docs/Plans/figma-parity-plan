     Saving Learnings to Mindbase                                                                                                                                                                                                                                                           
                                                                                                                                                                                                                                                                                            
     // Using Mindbase MCP tools                                                                                                                                                                                                                                                            
     async function saveLearningToMindbase(learning: UILearning) {                                                                                                                                                                                                                          
       await mcp__mindbase__memory_write({                                                                                                                                                                                                                                                  
         title: `UI Learning: ${learning.issue.description}`,                                                                                                                                                                                                                               
         content: JSON.stringify(learning),                                                                                                                                                                                                                                                 
         tags: ['ui-parity', learning.category, learning.issue.component]                                                                                                                                                                                                                   
       });                                                                                                                                                                                                                                                                                  
     }                                                                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                                                            
