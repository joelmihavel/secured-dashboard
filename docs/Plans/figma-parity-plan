     Design Tokens: Figma ↔ React Native Sync                                                                                                                                                                                                                                               
                                                                                                                                                                                                                                                                                            
     What Are Design Tokens?                                                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                                                            
     Design tokens are the single source of truth for design values. They have semantic names like colors/primary/500 instead of raw values like #FF9A6D.                                                                                                                                   
                                                                                                                                                                                                                                                                                            
     Figma Token System                                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                                                            
     Figma stores tokens as Variables:                                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                                                            
     // Figma Variable structure (from REST API or MCP)                                                                                                                                                                                                                                     
     interface FigmaVariable {                                                                                                                                                                                                                                                              
       id: string;                    // "VariableId:123"                                                                                                                                                                                                                                   
       name: string;                  // "colors/primary/500"                                                                                                                                                                                                                               
       resolvedType: 'COLOR' | 'FLOAT' | 'STRING' | 'BOOLEAN';                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                                                            
       // Values can differ by mode (light/dark)                                                                                                                                                                                                                                            
       valuesByMode: {                                                                                                                                                                                                                                                                      
         'ModeId:light': { r: 1, g: 0.6, b: 0.43, a: 1 },  // #FF9A6D                                                                                                                                                                                                                       
         'ModeId:dark': { r: 0.8, g: 0.48, b: 0.34, a: 1 }                                                                                                                                                                                                                                  
       };                                                                                                                                                                                                                                                                                   
                                                                                                                                                                                                                                                                                            
       // Code syntax hints from Figma                                                                                                                                                                                                                                                      
       codeSyntax?: {                                                                                                                                                                                                                                                                       
         WEB: 'var(--colors-primary-500)',                                                                                                                                                                                                                                                  
         iOS: 'Colors.primary500',                                                                                                                                                                                                                                                          
         ANDROID: 'R.color.colors_primary_500'                                                                                                                                                                                                                                              
       };                                                                                                                                                                                                                                                                                   
                                                                                                                                                                                                                                                                                            
       // Usage scopes                                                                                                                                                                                                                                                                      
       scopes: ['FRAME_FILL', 'SHAPE_FILL', 'STROKE_COLOR', 'TEXT_FILL'];                                                                                                                                                                                                                   
     }                                                                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                                                            
