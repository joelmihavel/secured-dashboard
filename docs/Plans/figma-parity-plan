     #!/bin/bash                                                                                                                                                                                                                                                                            
     # scripts/capture-impl-screenshot.sh                                                                                                                                                                                                                                                   
                                                                                                                                                                                                                                                                                            
     SCREEN_ID="$1"                                                                                                                                                                                                                                                                         
     OUTPUT_DIR="figma-parity/verification/screenshots/$SCREEN_ID"                                                                                                                                                                                                                          
     mkdir -p "$OUTPUT_DIR"                                                                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                                                            
     # 1. Capture raw screenshot                                                                                                                                                                                                                                                            
     xcrun simctl io booted screenshot "$OUTPUT_DIR/raw.png"                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                                                            
     # 2. Get dimensions (iPhone 14 Pro @3x)                                                                                                                                                                                                                                                
     # Screen: 393pt x 852pt → 1179px x 2556px at @3x                                                                                                                                                                                                                                       
                                                                                                                                                                                                                                                                                            
     # 3. Crop status bar (47pt = 141px @3x) and home indicator (34pt = 102px @3x)                                                                                                                                                                                                          
     magick "$OUTPUT_DIR/raw.png" -crop 1179x2313+0+141 +repage "$OUTPUT_DIR/impl.png"                                                                                                                                                                                                      
                                                                                                                                                                                                                                                                                            
     # 4. Also get Figma screenshot dimensions and resize if needed                                                                                                                                                                                                                         
     FIGMA_W=$(magick identify -format "%w" "figma-parity/data/screens/$SCREEN_ID/screenshot.png")                                                                                                                                                                                          
     FIGMA_H=$(magick identify -format "%h" "figma-parity/data/screens/$SCREEN_ID/screenshot.png")                                                                                                                                                                                          
                                                                                                                                                                                                                                                                                            
     # 5. Resize implementation to match Figma (if different)                                                                                                                                                                                                                               
     magick "$OUTPUT_DIR/impl.png" -resize "${FIGMA_W}x${FIGMA_H}!" "$OUTPUT_DIR/impl_resized.png"                                                                                                                                                                                          
                                                                                                                                                                                                                                                                                            
     echo "Screenshot saved: $OUTPUT_DIR/impl_resized.png"                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                                                            
     Pixel Comparison                                                                                                                                                                                                                                                                       
                                                                                                                                                                                                                                                                                            
     # Using ImageMagick                                                                                                                                                                                                                                                                    
     DIFF=$(magick compare -metric AE -fuzz 5% figma.png impl.png null: 2>&1)                                                                                                                                                                                                               
     TOTAL=$(magick identify -format "%[fx:w*h]" figma.png)                                                                                                                                                                                                                                 
     PERCENT=$(python3 -c "print(f'{($DIFF/$TOTAL)*100:.3f}')")                                                                                                                                                                                                                             
                                                                                                                                                                                                                                                                                            
     # Visual diff generation                                                                                                                                                                                                                                                               
     magick compare -highlight-color red figma.png impl.png diff.png                                                                                                                                                                                                                        
                                                                                                                                                                                                                                                                                            
