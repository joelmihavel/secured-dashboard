     Loading Learnings Before Processing                                                                                                                                                                                                                                                    
                                                                                                                                                                                                                                                                                            
     async function loadLearningsFromMindbase(): Promise<UILearning[]> {                                                                                                                                                                                                                    
       // Search for all UI parity learnings                                                                                                                                                                                                                                                
       const results = await mcp__mindbase__memory_search({                                                                                                                                                                                                                                 
         query: 'UI parity learning mistakes fixes',                                                                                                                                                                                                                                        
         tags: ['ui-parity'],                                                                                                                                                                                                                                                               
         limit: 50                                                                                                                                                                                                                                                                          
       });                                                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                                                            
       return results.map(r => JSON.parse(r.content));                                                                                                                                                                                                                                      
     }                                                                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                                                            
     // Apply learnings to new screen                                                                                                                                                                                                                                                       
     async function applyLearningsToScreen(                                                                                                                                                                                                                                                 
       screenId: string,                                                                                                                                                                                                                                                                    
       learnings: UILearning[]                                                                                                                                                                                                                                                              
     ) {                                                                                                                                                                                                                                                                                    
       const relevantLearnings = learnings.filter(l => {                                                                                                                                                                                                                                    
         // Check if learning applies to this screen's components                                                                                                                                                                                                                           
         return l.pattern.applicableTo.some(pattern =>                                                                                                                                                                                                                                      
           screenHasMatchingComponent(screenId, pattern)                                                                                                                                                                                                                                    
         );                                                                                                                                                                                                                                                                                 
       });                                                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                                                            
       console.log(`Applying ${relevantLearnings.length} relevant learnings:`);                                                                                                                                                                                                             
                                                                                                                                                                                                                                                                                            
       for (const learning of relevantLearnings) {                                                                                                                                                                                                                                          
         console.log(`- ${learning.pattern.rule}`);                                                                                                                                                                                                                                         
         // Pre-check code for this mistake                                                                                                                                                                                                                                                 
         await checkForMistake(screenId, learning);                                                                                                                                                                                                                                         
       }                                                                                                                                                                                                                                                                                    
     }                                                                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                                                            
