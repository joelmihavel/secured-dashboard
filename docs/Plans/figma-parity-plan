     Detecting Scrolling Behavior                                                                                                                                                                                                                                                           
                                                                                                                                                                                                                                                                                            
     // From Figma node properties                                                                                                                                                                                                                                                          
     function detectScrollBehavior(node: FigmaNode): ScrollConfig {                                                                                                                                                                                                                         
       return {                                                                                                                                                                                                                                                                             
         isScrollable: node.overflowDirection !== 'NONE',                                                                                                                                                                                                                                   
         direction: {                                                                                                                                                                                                                                                                       
           'HORIZONTAL': 'horizontal',                                                                                                                                                                                                                                                      
           'VERTICAL': 'vertical',                                                                                                                                                                                                                                                          
           'BOTH': 'both',                                                                                                                                                                                                                                                                  
           'NONE': null                                                                                                                                                                                                                                                                     
         }[node.overflowDirection],                                                                                                                                                                                                                                                         
         clipsContent: node.clipsContent,  // overflow: hidden                                                                                                                                                                                                                              
       };                                                                                                                                                                                                                                                                                   
     }                                                                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                                                            
     Detecting Prototype Interactions                                                                                                                                                                                                                                                       
                                                                                                                                                                                                                                                                                            
     // From node's reactions array (via REST API)                                                                                                                                                                                                                                          
     interface FigmaReaction {                                                                                                                                                                                                                                                              
       trigger: { type: 'ON_CLICK' | 'ON_HOVER' | 'ON_DRAG' | 'AFTER_TIMEOUT' };                                                                                                                                                                                                            
       actions: Array<{                                                                                                                                                                                                                                                                     
         type: 'NODE';                                                                                                                                                                                                                                                                      
         navigation: 'NAVIGATE' | 'OVERLAY' | 'SWAP' | 'SCROLL_TO';                                                                                                                                                                                                                         
         transition?: {                                                                                                                                                                                                                                                                     
           type: 'DISSOLVE' | 'SMART_ANIMATE' | 'MOVE_IN' | 'PUSH';                                                                                                                                                                                                                         
           duration: number;        // EXACT ms                                                                                                                                                                                                                                             
           easing: {                                                                                                                                                                                                                                                                        
             type: 'EASE_IN' | 'EASE_OUT' | 'CUSTOM_CUBIC_BEZIER';                                                                                                                                                                                                                          
             easingFunctionCubicBezier?: { x1, y1, x2, y2 };  // EXACT bezier                                                                                                                                                                                                               
           };                                                                                                                                                                                                                                                                               
         };                                                                                                                                                                                                                                                                                 
       }>;                                                                                                                                                                                                                                                                                  
     }                                                                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                                                            
     // Map to React Native animations                                                                                                                                                                                                                                                      
     function mapToReanimated(reaction: FigmaReaction): AnimationConfig {                                                                                                                                                                                                                   
       const transition = reaction.actions[0]?.transition;                                                                                                                                                                                                                                  
       return {                                                                                                                                                                                                                                                                             
         duration: transition?.duration || 300,                                                                                                                                                                                                                                             
         easing: transition?.easing.type === 'CUSTOM_CUBIC_BEZIER'                                                                                                                                                                                                                          
           ? Easing.bezier(                                                                                                                                                                                                                                                                 
               transition.easing.easingFunctionCubicBezier.x1,                                                                                                                                                                                                                              
               transition.easing.easingFunctionCubicBezier.y1,                                                                                                                                                                                                                              
               transition.easing.easingFunctionCubicBezier.x2,                                                                                                                                                                                                                              
               transition.easing.easingFunctionCubicBezier.y2                                                                                                                                                                                                                               
             )                                                                                                                                                                                                                                                                              
           : Easing.inOut(Easing.ease),                                                                                                                                                                                                                                                     
       };                                                                                                                                                                                                                                                                                   
     }                                                                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                                                            
