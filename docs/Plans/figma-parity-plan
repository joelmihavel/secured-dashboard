     await mcp__figma__add_code_connect_map({                                                                                                                                                                                                                                               
       nodeId: '41:4569',                    // Figma component node ID                                                                                                                                                                                                                     
       fileKey: 'HZaVuwWn6B6jOjrmxZ7Kzv',                                                                                                                                                                                                                                                   
       componentName: 'PrimaryButton',                                                                                                                                                                                                                                                      
       source: '/rn-app/src/components/ui/Button/PrimaryButton.tsx',                                                                                                                                                                                                                        
