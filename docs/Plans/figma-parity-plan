     Automated Fix Verification Script                                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                                                            
     // scripts/verify-fix.ts                                                                                                                                                                                                                                                               
     interface FixVerification {                                                                                                                                                                                                                                                            
       issueId: string;                                                                                                                                                                                                                                                                     
       description: string;                                                                                                                                                                                                                                                                 
       beforeDiff: number;                                                                                                                                                                                                                                                                  
       afterDiff: number;                                                                                                                                                                                                                                                                   
       fixed: boolean;                                                                                                                                                                                                                                                                      
       screenshotBefore: string;                                                                                                                                                                                                                                                            
       screenshotAfter: string;                                                                                                                                                                                                                                                             
     }                                                                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                                                            
     async function verifyFix(                                                                                                                                                                                                                                                              
       screenId: string,                                                                                                                                                                                                                                                                    
       issueId: string,                                                                                                                                                                                                                                                                     
       codeChange: () => Promise<void>                                                                                                                                                                                                                                                      
     ): Promise<FixVerification> {                                                                                                                                                                                                                                                          
                                                                                                                                                                                                                                                                                            
       // 1. Capture BEFORE screenshot                                                                                                                                                                                                                                                      
       console.log('Capturing before screenshot...');                                                                                                                                                                                                                                       
       const beforeScreenshot = await captureSimulator();                                                                                                                                                                                                                                   
       const beforeDiff = await compareWithFigma(screenId, beforeScreenshot);                                                                                                                                                                                                               
       console.log(`Before diff: ${beforeDiff.toFixed(2)}%`);                                                                                                                                                                                                                               
                                                                                                                                                                                                                                                                                            
       // 2. Apply the code fix                                                                                                                                                                                                                                                             
       console.log('Applying fix...');                                                                                                                                                                                                                                                      
       await codeChange();                                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                                                            
       // 3. Wait for hot reload                                                                                                                                                                                                                                                            
       console.log('Waiting for hot reload...');                                                                                                                                                                                                                                            
       await waitForHotReload(3000);                                                                                                                                                                                                                                                        
                                                                                                                                                                                                                                                                                            
       // 4. Capture AFTER screenshot                                                                                                                                                                                                                                                       
       console.log('Capturing after screenshot...');                                                                                                                                                                                                                                        
       const afterScreenshot = await captureSimulator();                                                                                                                                                                                                                                    
       const afterDiff = await compareWithFigma(screenId, afterScreenshot);                                                                                                                                                                                                                 
       console.log(`After diff: ${afterDiff.toFixed(2)}%`);                                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                                                            
       // 5. Determine if fixed                                                                                                                                                                                                                                                             
       const fixed = afterDiff < beforeDiff;                                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                                                            
       if (fixed) {                                                                                                                                                                                                                                                                         
         console.log(`✓ Fix verified! Diff improved: ${beforeDiff.toFixed(2)}% → ${afterDiff.toFixed(2)}%`);                                                                                                                                                                                
       } else {                                                                                                                                                                                                                                                                             
         console.log(`✗ Fix not verified. Diff: ${beforeDiff.toFixed(2)}% → ${afterDiff.toFixed(2)}%`);                                                                                                                                                                                     
       }                                                                                                                                                                                                                                                                                    
                                                                                                                                                                                                                                                                                            
       return { issueId, description: `Fixed ${issueId}`, beforeDiff, afterDiff, fixed, screenshotBefore, screenshotAfter };                                                                                                                                                                
     }                                                                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                                                            
     // Capture screenshot from running simulator                                                                                                                                                                                                                                           
     async function captureSimulator(): Promise<string> {                                                                                                                                                                                                                                   
       const outputPath = `verification/temp_${Date.now()}.png`;                                                                                                                                                                                                                            
       await execAsync(`xcrun simctl io booted screenshot ${outputPath}`);                                                                                                                                                                                                                  
       return outputPath;                                                                                                                                                                                                                                                                   
     }                                                                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                                                            
     // Compare implementation against Figma                                                                                                                                                                                                                                                
     async function compareWithFigma(screenId: string, implPath: string): Promise<number> {                                                                                                                                                                                                 
       const figmaPath = `data/screens/${screenId}/screenshot.png`;                                                                                                                                                                                                                         
                                                                                                                                                                                                                                                                                            
       // Resize impl to match Figma dimensions                                                                                                                                                                                                                                             
       const figmaDims = await getImageDimensions(figmaPath);                                                                                                                                                                                                                               
       await execAsync(`magick ${implPath} -resize ${figmaDims.width}x${figmaDims.height}! ${implPath}`);                                                                                                                                                                                   
                                                                                                                                                                                                                                                                                            
       // Calculate pixel difference                                                                                                                                                                                                                                                        
       const diffPixels = parseInt(await execAsync(                                                                                                                                                                                                                                         
         `magick compare -metric AE -fuzz 5% ${figmaPath} ${implPath} null: 2>&1`                                                                                                                                                                                                           
       ));                                                                                                                                                                                                                                                                                  
       const totalPixels = figmaDims.width * figmaDims.height;                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                                                            
       return (diffPixels / totalPixels) * 100;                                                                                                                                                                                                                                             
     }                                                                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                                                            
