     React Native Handles Scaling Automatically                                                                                                                                                                                                                                             
                                                                                                                                                                                                                                                                                            
     Your existing design system at /rn-app/src/theme/scale.ts handles responsive scaling:                                                                                                                                                                                                  
                                                                                                                                                                                                                                                                                            
     // Already in your codebase                                                                                                                                                                                                                                                            
     import { Dimensions } from 'react-native';                                                                                                                                                                                                                                             
                                                                                                                                                                                                                                                                                            
     const { width: SCREEN_WIDTH } = Dimensions.get('window');                                                                                                                                                                                                                              
     const BASE_WIDTH = 393; // iPhone 14 Pro (Figma design base)                                                                                                                                                                                                                           
                                                                                                                                                                                                                                                                                            
     // Scale any dimension proportionally                                                                                                                                                                                                                                                  
     export function scaled(size: number, min?: number, max?: number): number {                                                                                                                                                                                                             
       const scaledSize = (size / BASE_WIDTH) * SCREEN_WIDTH;                                                                                                                                                                                                                               
       if (min !== undefined && scaledSize < min) return min;                                                                                                                                                                                                                               
       if (max !== undefined && scaledSize > max) return max;                                                                                                                                                                                                                               
       return scaledSize;                                                                                                                                                                                                                                                                   
     }                                                                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                                                            
     // For fonts with constrained scaling (±15%)                                                                                                                                                                                                                                           
     export function scaledFont(size: number): number {                                                                                                                                                                                                                                     
       const scale = SCREEN_WIDTH / BASE_WIDTH;                                                                                                                                                                                                                                             
       const constrainedScale = Math.min(Math.max(scale, 0.85), 1.15);                                                                                                                                                                                                                      
       return size * constrainedScale;                                                                                                                                                                                                                                                      
     }                                                                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                                                            
     // For spacing with constrained scaling (±25%)                                                                                                                                                                                                                                         
     export function scaledSpacing(value: number): number {                                                                                                                                                                                                                                 
       const scale = SCREEN_WIDTH / BASE_WIDTH;                                                                                                                                                                                                                                             
       const constrainedScale = Math.min(Math.max(scale, 0.75), 1.25);                                                                                                                                                                                                                      
       return value * constrainedScale;                                                                                                                                                                                                                                                     
     }                                                                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                                                            
     Why This Works for Multi-Device                                                                                                                                                                                                                                                        
     ┌───────────────────┬───────┬──────────────┬──────────────────────┐                                                                                                                                                                                                                    
     │      Device       │ Width │ Scale Factor │ 16pt spacing becomes │                                                                                                                                                                                                                    
     ├───────────────────┼───────┼──────────────┼──────────────────────┤                                                                                                                                                                                                                    
     │ iPhone SE         │ 375pt │ 0.954        │ ~15pt                │                                                                                                                                                                                                                    
     ├───────────────────┼───────┼──────────────┼──────────────────────┤                                                                                                                                                                                                                    
     │ iPhone 14         │ 390pt │ 0.992        │ ~16pt                │                                                                                                                                                                                                                    
     ├───────────────────┼───────┼──────────────┼──────────────────────┤                                                                                                                                                                                                                    
     │ iPhone 14 Pro     │ 393pt │ 1.000 (base) │ 16pt                 │                                                                                                                                                                                                                    
