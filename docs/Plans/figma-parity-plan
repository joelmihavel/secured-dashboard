     Error Handling for Gemini API                                                                                                                                                                                                                                                          
                                                                                                                                                                                                                                                                                            
     async function callGeminiWithRetry(                                                                                                                                                                                                                                                    
       figmaPath: string,                                                                                                                                                                                                                                                                   
       implPath: string,                                                                                                                                                                                                                                                                    
       prompt: string,                                                                                                                                                                                                                                                                      
       maxRetries: number = 3                                                                                                                                                                                                                                                               
     ): Promise<GeminiResponse> {                                                                                                                                                                                                                                                           
       for (let i = 0; i < maxRetries; i++) {                                                                                                                                                                                                                                               
         try {                                                                                                                                                                                                                                                                              
           const response = await callGemini(figmaPath, implPath, prompt);                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                                                            
           // Check for API errors                                                                                                                                                                                                                                                          
           if (response.error) {                                                                                                                                                                                                                                                            
             console.log(`Gemini API error: ${response.error.message}`);                                                                                                                                                                                                                    
             if (i < maxRetries - 1) {                                                                                                                                                                                                                                                      
               console.log(`Retrying in ${(i + 1) * 2} seconds...`);                                                                                                                                                                                                                        
               await sleep((i + 1) * 2000);                                                                                                                                                                                                                                                 
               continue;                                                                                                                                                                                                                                                                    
             }                                                                                                                                                                                                                                                                              
           }                                                                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                                                            
           return response;                                                                                                                                                                                                                                                                 
         } catch (err) {                                                                                                                                                                                                                                                                    
           console.log(`Request failed: ${err.message}`);                                                                                                                                                                                                                                   
           if (i < maxRetries - 1) {                                                                                                                                                                                                                                                        
             await sleep((i + 1) * 2000);                                                                                                                                                                                                                                                   
           }                                                                                                                                                                                                                                                                                
         }                                                                                                                                                                                                                                                                                  
       }                                                                                                                                                                                                                                                                                    
                                                                                                                                                                                                                                                                                            
       throw new Error('Gemini API call failed after retries');                                                                                                                                                                                                                             
     }                                                                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                                                            
