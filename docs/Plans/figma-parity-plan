     Exact Properties We Extract Per Node                                                                                                                                                                                                                                                   
                                                                                                                                                                                                                                                                                            
     // Every node gives us these EXACT values (not approximations)                                                                                                                                                                                                                         
     interface FigmaNodeExact {                                                                                                                                                                                                                                                             
       // Geometry (exact pixels)                                                                                                                                                                                                                                                           
       absoluteBoundingBox: { x, y, width, height };                                                                                                                                                                                                                                        
       rotation: number;                                                                                                                                                                                                                                                                    
                                                                                                                                                                                                                                                                                            
       // Fills (exact RGBA 0-1 scale → convert to hex)                                                                                                                                                                                                                                     
       fills: Array<{                                                                                                                                                                                                                                                                       
         type: 'SOLID' | 'GRADIENT_LINEAR' | 'IMAGE';                                                                                                                                                                                                                                       
         color?: { r: 0-1, g: 0-1, b: 0-1, a: 0-1 };  // EXACT                                                                                                                                                                                                                              
         gradientStops?: Array<{ position: 0-1, color }>;                                                                                                                                                                                                                                   
       }>;                                                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                                                            
       // Strokes (exact values)                                                                                                                                                                                                                                                            
       strokes: Paint[];                                                                                                                                                                                                                                                                    
       strokeWeight: number;           // EXACT px                                                                                                                                                                                                                                          
       strokeAlign: 'INSIDE' | 'CENTER' | 'OUTSIDE';                                                                                                                                                                                                                                        
                                                                                                                                                                                                                                                                                            
       // Effects (exact shadow values)                                                                                                                                                                                                                                                     
       effects: Array<{                                                                                                                                                                                                                                                                     
         type: 'DROP_SHADOW' | 'INNER_SHADOW' | 'LAYER_BLUR';                                                                                                                                                                                                                               
         color: { r, g, b, a };        // EXACT                                                                                                                                                                                                                                             
         offset: { x, y };             // EXACT px                                                                                                                                                                                                                                          
         radius: number;               // EXACT blur px                                                                                                                                                                                                                                     
         spread: number;               // EXACT spread px                                                                                                                                                                                                                                   
       }>;                                                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                                                            
       // Corner Radius (exact, can be per-corner)                                                                                                                                                                                                                                          
       cornerRadius?: number;                                                                                                                                                                                                                                                               
       topLeftRadius?: number;                                                                                                                                                                                                                                                              
       topRightRadius?: number;                                                                                                                                                                                                                                                             
       bottomLeftRadius?: number;                                                                                                                                                                                                                                                           
       bottomRightRadius?: number;                                                                                                                                                                                                                                                          
                                                                                                                                                                                                                                                                                            
       // Auto Layout (exact values → direct flexbox mapping)                                                                                                                                                                                                                               
       layoutMode: 'HORIZONTAL' | 'VERTICAL' | 'NONE';                                                                                                                                                                                                                                      
       primaryAxisAlignItems: 'MIN' | 'CENTER' | 'MAX' | 'SPACE_BETWEEN';                                                                                                                                                                                                                   
       counterAxisAlignItems: 'MIN' | 'CENTER' | 'MAX' | 'BASELINE';                                                                                                                                                                                                                        
       paddingTop: number;             // EXACT px                                                                                                                                                                                                                                          
       paddingRight: number;           // EXACT px                                                                                                                                                                                                                                          
       paddingBottom: number;          // EXACT px                                                                                                                                                                                                                                          
       paddingLeft: number;            // EXACT px                                                                                                                                                                                                                                          
       itemSpacing: number;            // EXACT gap px                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                                                            
       // Typography (TEXT nodes only - EXACT values)                                                                                                                                                                                                                                       
       style?: {                                                                                                                                                                                                                                                                            
         fontFamily: string;           // EXACT font name                                                                                                                                                                                                                                   
         fontSize: number;             // EXACT px                                                                                                                                                                                                                                          
         fontWeight: 100-900;          // EXACT weight                                                                                                                                                                                                                                      
         lineHeightPx: number;         // EXACT line height px                                                                                                                                                                                                                              
         letterSpacing: number;        // EXACT letter spacing px                                                                                                                                                                                                                           
         textAlignHorizontal: 'LEFT' | 'CENTER' | 'RIGHT';                                                                                                                                                                                                                                  
         textCase: 'ORIGINAL' | 'UPPER' | 'LOWER';                                                                                                                                                                                                                                          
       };                                                                                                                                                                                                                                                                                   
                                                                                                                                                                                                                                                                                            
       // Opacity & Blend                                                                                                                                                                                                                                                                   
       opacity: number;                // EXACT 0-1                                                                                                                                                                                                                                         
       blendMode: string;                                                                                                                                                                                                                                                                   
     }                                                                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                                                            
