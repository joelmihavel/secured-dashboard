         body: JSON.stringify({                                                                                                                                                                                                                                                             
           contents: [{                                                                                                                                                                                                                                                                     
             parts: [                                                                                                                                                                                                                                                                       
               { text: prompt },                                                                                                                                                                                                                                                            
               { inlineData: { mimeType: 'image/png', data: figmaBase64 } },                                                                                                                                                                                                                
               { inlineData: { mimeType: 'image/png', data: implBase64 } }                                                                                                                                                                                                                  
