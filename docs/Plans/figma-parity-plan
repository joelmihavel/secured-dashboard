     // Get component structure understanding                                                                                                                                                                                                                                               
     async function analyzeComponentStructure(componentPath: string) {                                                                                                                                                                                                                      
       // Get symbol overview                                                                                                                                                                                                                                                               
       const symbols = await mcp__serena__get_symbols_overview({                                                                                                                                                                                                                            
         relative_path: componentPath,                                                                                                                                                                                                                                                      
         depth: 2                                                                                                                                                                                                                                                                           
       });                                                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                                                            
       // Find styling patterns                                                                                                                                                                                                                                                             
       const styles = await mcp__serena__find_symbol({                                                                                                                                                                                                                                      
         name_path: 'styles',                                                                                                                                                                                                                                                               
         relative_path: componentPath,                                                                                                                                                                                                                                                      
         include_body: true                                                                                                                                                                                                                                                                 
       });                                                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                                                            
       return { symbols, styles };                                                                                                                                                                                                                                                          
     }                                                                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                                                            
