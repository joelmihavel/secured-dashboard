     async function extractScreen(nodeId: string) {                                                                                                                                                                                                                                         
       // 1. REST API: Get COMPLETE node tree with ALL properties                                                                                                                                                                                                                           
       const nodeTree = await fetchNodes(nodeId);  // Contains EXACT values                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                                                            
       // 2. Parse node tree to extract deterministic values                                                                                                                                                                                                                                
       const extractedData = parseNodeTree(nodeTree, {                                                                                                                                                                                                                                      
         geometry: true,      // x, y, width, height (EXACT)                                                                                                                                                                                                                                
         fills: true,         // colors with RGBA (EXACT)                                                                                                                                                                                                                                   
         strokes: true,       // borders (EXACT)                                                                                                                                                                                                                                            
         effects: true,       // shadows (EXACT)                                                                                                                                                                                                                                            
         typography: true,    // fonts, sizes (EXACT)                                                                                                                                                                                                                                       
         autoLayout: true,    // flexbox values (EXACT)                                                                                                                                                                                                                                     
         cornerRadius: true,  // radii (EXACT)                                                                                                                                                                                                                                              
       });                                                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                                                            
       // 3. MCP: Get design context for code hints & assets                                                                                                                                                                                                                                
       const designContext = await mcp__figma__get_design_context({                                                                                                                                                                                                                         
         nodeId,                                                                                                                                                                                                                                                                            
         fileKey,                                                                                                                                                                                                                                                                           
         clientLanguages: 'typescript',                                                                                                                                                                                                                                                     
         clientFrameworks: 'react-native,nativewind',                                                                                                                                                                                                                                       
         forceCode: true                                                                                                                                                                                                                                                                    
       });                                                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                                                            
       // 4. MCP: Get variable definitions for token mapping                                                                                                                                                                                                                                
       const variables = await mcp__figma__get_variable_defs({ nodeId, fileKey });                                                                                                                                                                                                          
                                                                                                                                                                                                                                                                                            
       // 5. MAP extracted values to design system tokens                                                                                                                                                                                                                                   
       const mappedData = mapToDesignTokens(extractedData, variables);                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                                                            
       // 6. MCP: Get hierarchy for component breakdown                                                                                                                                                                                                                                     
       const metadata = await mcp__figma__get_metadata({ nodeId, fileKey });                                                                                                                                                                                                                
       const components = parseHierarchy(metadata);                                                                                                                                                                                                                                         
                                                                                                                                                                                                                                                                                            
       // 7. Recursively extract each component (with EXACT values)                                                                                                                                                                                                                         
       for (const comp of components) {                                                                                                                                                                                                                                                     
         await extractComponent(comp.nodeId);                                                                                                                                                                                                                                               
       }                                                                                                                                                                                                                                                                                    
                                                                                                                                                                                                                                                                                            
       // 8. REST API: Download assets (SVGs at original quality)                                                                                                                                                                                                                           
       await downloadAssets(designContext.downloadUrls);                                                                                                                                                                                                                                    
                                                                                                                                                                                                                                                                                            
       // 9. REST API: Get screenshot for VERIFICATION only                                                                                                                                                                                                                                 
       const screenshot = await fetchScreenshot(nodeId, scale=3);                                                                                                                                                                                                                           
                                                                                                                                                                                                                                                                                            
       // 10. Save complete extraction with exact values                                                                                                                                                                                                                                    
       await saveScreenData(nodeId, {                                                                                                                                                                                                                                                       
         exactValues: extractedData,    // DETERMINISTIC                                                                                                                                                                                                                                    
         tokenMapping: mappedData,      // SEMANTIC                                                                                                                                                                                                                                         
         designContext,                 // CODE HINTS                                                                                                                                                                                                                                       
         screenshot,                    // VERIFICATION                                                                                                                                                                                                                                     
         components                                                                                                                                                                                                                                                                         
       });                                                                                                                                                                                                                                                                                  
     }                                                                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                                                            
     Exact Value → React Native Mapping                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                                                            
     // Figma color (0-1 scale) → React Native hex                                                                                                                                                                                                                                          
     function figmaColorToHex(color: { r, g, b, a }): string {                                                                                                                                                                                                                              
       const r = Math.round(color.r * 255);                                                                                                                                                                                                                                                 
       const g = Math.round(color.g * 255);                                                                                                                                                                                                                                                 
       const b = Math.round(color.b * 255);                                                                                                                                                                                                                                                 
       return `#${r.toString(16).padStart(2,'0')}${g.toString(16).padStart(2,'0')}${b.toString(16).padStart(2,'0')}`;                                                                                                                                                                       
       // EXACT - no guessing                                                                                                                                                                                                                                                               
     }                                                                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                                                            
     // Figma auto-layout → React Native flexbox                                                                                                                                                                                                                                            
     function figmaLayoutToFlex(node: FigmaNode): StyleSheet {                                                                                                                                                                                                                              
       return {                                                                                                                                                                                                                                                                             
         flexDirection: node.layoutMode === 'HORIZONTAL' ? 'row' : 'column',                                                                                                                                                                                                                
         justifyContent: {                                                                                                                                                                                                                                                                  
           'MIN': 'flex-start',                                                                                                                                                                                                                                                             
           'CENTER': 'center',                                                                                                                                                                                                                                                              
           'MAX': 'flex-end',                                                                                                                                                                                                                                                               
           'SPACE_BETWEEN': 'space-between'                                                                                                                                                                                                                                                 
         }[node.primaryAxisAlignItems],                                                                                                                                                                                                                                                     
         alignItems: {                                                                                                                                                                                                                                                                      
           'MIN': 'flex-start',                                                                                                                                                                                                                                                             
           'CENTER': 'center',                                                                                                                                                                                                                                                              
           'MAX': 'flex-end',                                                                                                                                                                                                                                                               
           'BASELINE': 'baseline'                                                                                                                                                                                                                                                           
         }[node.counterAxisAlignItems],                                                                                                                                                                                                                                                     
         gap: node.itemSpacing,              // EXACT                                                                                                                                                                                                                                       
         paddingTop: node.paddingTop,        // EXACT                                                                                                                                                                                                                                       
         paddingRight: node.paddingRight,    // EXACT                                                                                                                                                                                                                                       
         paddingBottom: node.paddingBottom,  // EXACT                                                                                                                                                                                                                                       
         paddingLeft: node.paddingLeft,      // EXACT                                                                                                                                                                                                                                       
       };                                                                                                                                                                                                                                                                                   
     }                                                                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                                                            
     // Figma shadow → React Native shadow                                                                                                                                                                                                                                                  
     function figmaShadowToRN(effect: FigmaEffect): ShadowStyle {                                                                                                                                                                                                                           
       return {                                                                                                                                                                                                                                                                             
         shadowColor: figmaColorToHex(effect.color),                                                                                                                                                                                                                                        
