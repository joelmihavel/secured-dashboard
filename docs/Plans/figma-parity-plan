     Batch Processing Script                                                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                                                            
     // scripts/process-batches.ts                                                                                                                                                                                                                                                          
     interface BatchConfig {                                                                                                                                                                                                                                                                
       screens: ScreenInfo[];                                                                                                                                                                                                                                                               
       batchSize: number;                                                                                                                                                                                                                                                                   
       saveLearningsAfterBatch: boolean;                                                                                                                                                                                                                                                    
     }                                                                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                                                            
     async function processBatches(config: BatchConfig) {                                                                                                                                                                                                                                   
       const batches = chunkArray(config.screens, config.batchSize);                                                                                                                                                                                                                        
       const totalBatches = batches.length;                                                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                                                            
       for (let i = 0; i < totalBatches; i++) {                                                                                                                                                                                                                                             
         const batch = batches[i];                                                                                                                                                                                                                                                          
         console.log(`\n=== BATCH ${i + 1}/${totalBatches} ===`);                                                                                                                                                                                                                           
         console.log(`Processing screens: ${batch.map(s => s.name).join(', ')}`);                                                                                                                                                                                                           
                                                                                                                                                                                                                                                                                            
         // 1. Load previous learnings from Mindbase                                                                                                                                                                                                                                        
         const learnings = await loadLearningsFromMindbase();                                                                                                                                                                                                                               
         console.log(`Loaded ${learnings.length} previous learnings`);                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                                                            
         // 2. Process each screen in batch                                                                                                                                                                                                                                                 
         for (const screen of batch) {                                                                                                                                                                                                                                                      
           await processScreen(screen, learnings);                                                                                                                                                                                                                                          
         }                                                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                                                            
         // 3. Save new learnings to Mindbase                                                                                                                                                                                                                                               
         if (config.saveLearningsAfterBatch) {                                                                                                                                                                                                                                              
           await saveLearningsToMindbase(batch);                                                                                                                                                                                                                                            
         }                                                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                                                            
         // 4. Generate batch report                                                                                                                                                                                                                                                        
         await generateBatchReport(i + 1, batch);                                                                                                                                                                                                                                           
                                                                                                                                                                                                                                                                                            
         console.log(`Batch ${i + 1} complete. Clearing context...`);                                                                                                                                                                                                                       
       }                                                                                                                                                                                                                                                                                    
                                                                                                                                                                                                                                                                                            
       // Generate final summary                                                                                                                                                                                                                                                            
       await generateFinalReport();                                                                                                                                                                                                                                                         
     }                                                                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                                                            
     function chunkArray<T>(array: T[], size: number): T[][] {                                                                                                                                                                                                                              
       const chunks: T[][] = [];                                                                                                                                                                                                                                                            
       for (let i = 0; i < array.length; i += size) {                                                                                                                                                                                                                                       
         chunks.push(array.slice(i, i + size));                                                                                                                                                                                                                                             
       }                                                                                                                                                                                                                                                                                    
       return chunks;                                                                                                                                                                                                                                                                       
     }                                                                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                                                            
