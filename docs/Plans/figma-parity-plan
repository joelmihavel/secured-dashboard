     // scripts/verify-tokens.ts                                                                                                                                                                                                                                                            
     interface TokenVerification {                                                                                                                                                                                                                                                          
       token: string;                                                                                                                                                                                                                                                                       
       figmaValue: any;                                                                                                                                                                                                                                                                     
       rnValue: any;                                                                                                                                                                                                                                                                        
       status: 'match' | 'mismatch' | 'missing_in_rn' | 'extra_in_rn';                                                                                                                                                                                                                      
     }                                                                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                                                            
     async function verifyTokens(): Promise<TokenVerification[]> {                                                                                                                                                                                                                          
       // 1. Get Figma tokens                                                                                                                                                                                                                                                               
       const figmaTokens = await mcp__figma__get_variable_defs({...});                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                                                            
       // 2. Load RN tokens                                                                                                                                                                                                                                                                 
       const rnTokens = await parseThemeFiles('/rn-app/src/theme/');                                                                                                                                                                                                                        
                                                                                                                                                                                                                                                                                            
       // 3. Load mappings                                                                                                                                                                                                                                                                  
       const mappings = loadMappings('token-mapping.json');                                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                                                            
       // 4. Compare                                                                                                                                                                                                                                                                        
       const results: TokenVerification[] = [];                                                                                                                                                                                                                                             
                                                                                                                                                                                                                                                                                            
       for (const [figmaName, figmaValue] of Object.entries(figmaTokens)) {                                                                                                                                                                                                                 
         const rnPath = mappings[figmaName];                                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                                                            
         if (!rnPath) {                                                                                                                                                                                                                                                                     
           results.push({ token: figmaName, figmaValue, rnValue: null, status: 'missing_in_rn' });                                                                                                                                                                                          
           continue;                                                                                                                                                                                                                                                                        
         }                                                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                                                            
         const rnValue = getValueByPath(rnTokens, rnPath);                                                                                                                                                                                                                                  
         const match = valuesMatch(figmaValue, rnValue);                                                                                                                                                                                                                                    
                                                                                                                                                                                                                                                                                            
         results.push({                                                                                                                                                                                                                                                                     
           token: figmaName,                                                                                                                                                                                                                                                                
           figmaValue,                                                                                                                                                                                                                                                                      
           rnValue,                                                                                                                                                                                                                                                                         
           status: match ? 'match' : 'mismatch'                                                                                                                                                                                                                                             
         });                                                                                                                                                                                                                                                                                
       }                                                                                                                                                                                                                                                                                    
                                                                                                                                                                                                                                                                                            
       return results;                                                                                                                                                                                                                                                                      
     }                                                                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                                                            
