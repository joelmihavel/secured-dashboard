     Extracting Tokens from Figma                                                                                                                                                                                                                                                           
                                                                                                                                                                                                                                                                                            
     // Using MCP                                                                                                                                                                                                                                                                           
     const tokens = await mcp__figma__get_variable_defs({                                                                                                                                                                                                                                   
       nodeId: 'PAGE_NODE_ID',                                                                                                                                                                                                                                                              
       fileKey: 'HZaVuwWn6B6jOjrmxZ7Kzv',                                                                                                                                                                                                                                                   
       clientLanguages: 'typescript',                                                                                                                                                                                                                                                       
       clientFrameworks: 'react-native'                                                                                                                                                                                                                                                     
     });                                                                                                                                                                                                                                                                                    
                                                                                                                                                                                                                                                                                            
     // Result: { 'colors/primary/500': '#FF9A6D', 'spacing/md': 16, ... }                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                                                            
     // Using REST API (Enterprise only)                                                                                                                                                                                                                                                    
     const response = await fetch(                                                                                                                                                                                                                                                          
       `https://api.figma.com/v1/files/${fileKey}/variables/local`,                                                                                                                                                                                                                         
       { headers: { 'X-Figma-Token': token } }                                                                                                                                                                                                                                              
     );                                                                                                                                                                                                                                                                                     
     const variables = response.meta.variables;                                                                                                                                                                                                                                             
                                                                                                                                                                                                                                                                                            
