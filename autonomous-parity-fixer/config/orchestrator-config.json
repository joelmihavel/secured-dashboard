{
  "_description": "Configuration for the autonomous parity fixer orchestrator",
  "processing": {
    "maxRetries": 3,
    "checkpointInterval": 1,
    "timeoutMs": 300000,
    "delayBetweenDesignsMs": 2000
  },
  "gates": {
    "preFeedback": {
      "enabled": true,
      "threshold": 95,
      "maxIterations": 10,
      "description": "Run after extraction, before Gemini feedback. Must reach 95% coverage."
    },
    "postFeedback": {
      "enabled": true,
      "threshold": 100,
      "maxIterations": 10,
      "description": "Run after Gemini feedback. Must reach 100% coverage before proceeding to next screen."
    }
  },
  "reviewRounds": {
    "total": 3,
    "focus": [
      "structural",
      "style-tokens",
      "layout-accuracy"
    ]
  },
  "feedbackRounds": {
    "total": 3,
    "focus": [
      "critical",
      "major",
      "minor"
    ]
  },
  "verification": {
    "minParityScore": 95,
    "passThreshold": 90
  },
  "paths": {
    "rnApp": "../rn-app",
    "processingDir": "processing",
    "outputDir": "output",
    "logsDir": "logs",
    "coverageReports": "reports/coverage"
  }
}
