# admin-app/.env.local.example — copy to .env.local and fill in values
#
# Phase A (2026-04-26): service-role keys MUST be server-only (no
# NEXT_PUBLIC_ prefix). The browser bundle never sees them. The
# /api/admin route handler reads these on the server side via
# admin-app/src/lib/env-server.ts.
#
# DO NOT add NEXT_PUBLIC_ prefix to anything containing "_SERVICE_ROLE_KEY"
# or you'll re-introduce the Phase A vulnerability.
#
# For Vercel: set the same vars in Vercel Project Settings → Environment
# Variables. NEXT_PUBLIC_* vars get bundled into the browser; everything
# else stays on the server.

# ─── Browser-safe (anon keys + URL) ────────────────────────────────────
# These ARE bundled into client JS. Anon keys are designed for that.
NEXT_PUBLIC_SUPABASE_DEV_ANON_KEY=eyJ...        # dev Supabase project anon key
NEXT_PUBLIC_SUPABASE_MAIN_ANON_KEY=eyJ...       # main Supabase project anon key
NEXT_PUBLIC_ADMIN_KEY=...                       # shared key for admin-waitlist edge fn

# ─── Server-only (service-role keys) ───────────────────────────────────
# NO NEXT_PUBLIC_ prefix. Available to:
#   - /api/admin/route.ts (and any other route handler)
#   - Server Components (page.tsx files NOT marked "use client")
#   - Server Actions
# These NEVER reach the browser. If you accidentally prefix one with
# NEXT_PUBLIC_, Next.js will bundle it client-side — that's the bug
# Phase A fixed; don't reintroduce it.
SUPABASE_SERVICE_ROLE_KEY=eyJ...                # main Supabase project service-role
SUPABASE_DEV_SERVICE_ROLE_KEY=eyJ...            # dev Supabase project service-role

# Optional URL overrides (defaults are baked into env-server.ts):
# SUPABASE_URL=https://uowjtrzmszuaiokqxgir.supabase.co
# SUPABASE_DEV_URL=https://zqlowjveyqiagnbmfwsb.supabase.co
