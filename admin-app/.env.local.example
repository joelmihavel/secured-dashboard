# admin-app/.env.local.example — copy to .env.local and fill in values
#
# Phase A (2026-04-26): service-role keys MUST be server-only (no
# NEXT_PUBLIC_ prefix). Browser bundle never sees them.
#
# Phase B (2026-05-01): admin_key for the admin-waitlist edge function
# moved server-side too (was NEXT_PUBLIC_ADMIN_KEY). Email allow-list
# (ADMIN_EMAILS) gates every dashboard route via src/middleware.ts.
#
# DO NOT add NEXT_PUBLIC_ prefix to anything containing "_SERVICE_ROLE_KEY",
# "ADMIN_KEY", or "ADMIN_EMAILS" or you'll re-introduce the leak.

# ─── Local-dev switches (omit both in any deployed environment) ──────────
# BYPASS_AUTH=true   skips the middleware session check AND the ADMIN_EMAILS
#                    allow-list — every request runs as "local@admin.dev" with
#                    the service-role key. Never set this on a deployment.
# READ_ONLY=true     /api/admin rejects every op except `fetch-view` and
#                    `fetch-landlord-review-queue` with 403 "This deployment is
#                    read-only". Approve/reject silently fail while it's on —
#                    check this first if writes appear to do nothing.

# ─── Browser-safe (anon keys) ────────────────────────────────────────────
# These ARE bundled into client JS. Anon keys are designed for that.
NEXT_PUBLIC_SUPABASE_DEV_ANON_KEY=eyJ...        # dev Supabase project anon key
NEXT_PUBLIC_SUPABASE_MAIN_ANON_KEY=eyJ...       # main (prod) Supabase project anon key

# ─── Server-only (service-role + admin secrets) ──────────────────────────
# Available to /api/admin route, Server Components, middleware.
SUPABASE_SERVICE_ROLE_KEY=eyJ...                # main Supabase project service-role
SUPABASE_DEV_SERVICE_ROLE_KEY=eyJ...            # dev Supabase project service-role

# Shared key validated by the admin-waitlist edge function. Must match the
# `ADMIN_API_KEY` env var on the prod admin-waitlist edge fn — mismatch
# returns 401 from every approve/reject. /api/admin injects this server-side.
ADMIN_KEY=...

# Comma-separated email allow-list for the admin panel. Anyone outside
# this list is rejected even if they have a Supabase auth.users entry.
ADMIN_EMAILS=rishabh@flent.in

# Optional URL overrides (defaults are baked into env-server.ts):
# SUPABASE_URL=https://uowjtrzmszuaiokqxgir.supabase.co
# SUPABASE_DEV_URL=https://zqlowjveyqiagnbmfwsb.supabase.co
