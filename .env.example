# Flent Secured v2 - Environment Variables Template
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control

# ==============================================
# SUPABASE (Local Development)
# ==============================================
# Get these from: supabase status (after running supabase start)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your_local_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_local_service_role_key

# ==============================================
# SUPABASE (Production) - DO NOT USE FOR TESTING
# ==============================================
# SUPABASE_PROD_URL=https://uowjtrzmszuaiokqxgir.supabase.co
# SUPABASE_PROD_ANON_KEY=<never_commit_this>
# SUPABASE_PROD_SERVICE_ROLE_KEY=<never_commit_this>

# ==============================================
# PAYU SANDBOX
# ==============================================
# Sandbox credentials for testing (safe to use)
PAYU_MERCHANT_KEY=gtKFFx
PAYU_MERCHANT_SALT=eCwWELxi
PAYU_BASE_URL=https://sandboxsecure.payu.in

# Test cards:
# - Success: 4012001037141112 (Visa), CVV: 123, Any future expiry
# - Failure: 5123456789012346 (Mastercard)
# Test UPI: success@payu, failure@payu

# ==============================================
# CASHFREE SANDBOX
# ==============================================
# Get sandbox credentials at: https://merchant.cashfree.com/merchant/dashboard
CASHFREE_APP_ID=your_sandbox_app_id
CASHFREE_SECRET_KEY=your_sandbox_secret
CASHFREE_BASE_URL=https://sandbox.cashfree.com/verification

# Test data:
# - Valid account: 026291800001191, IFSC: YESB0000262
# - Invalid account: 1234567890123456, IFSC: SBIN0000001
# - Mobile 360 test: 9876543210 (found), 9999999999 (not found)

# ==============================================
# TWILIO
# ==============================================
# Get credentials at: https://console.twilio.com
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_VERIFY_SERVICE_SID=your_verify_service_sid

# Test mode: Use OTP 123456 (must enable in Twilio console)

# ==============================================
# GCP (Document AI + Vertex AI)
# ==============================================
GCP_PROJECT_ID=your_gcp_project_id
GCP_LOCATION=us
GCP_DOCUMENT_AI_PROCESSOR_ID=your_processor_id
# Service account JSON path (for local dev only)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ==============================================
# SAUCE LABS (Visual Testing)
# ==============================================
SAUCE_USERNAME=your_sauce_username
SAUCE_ACCESS_KEY=your_sauce_access_key

# ==============================================
# COMPANY INFO (for receipts)
# ==============================================
COMPANY_NAME=Flent Technologies Private Limited
COMPANY_ADDRESS=Bangalore, Karnataka, India
COMPANY_GSTIN=your_gstin_here
SUPPORT_EMAIL=support@flentsecured.com
SUPPORT_PHONE=+91-XXXXXXXXXX

# ==============================================
# ENCRYPTION
# ==============================================
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=your_base64_encoded_32_byte_key

# ==============================================
# FEATURE FLAGS
# ==============================================
ENABLE_SANDBOX_MODE=true
ENABLE_TEST_CREDENTIALS=true
LOG_LEVEL=debug
