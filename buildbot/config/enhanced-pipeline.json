    },
    "profile": {
      "navigationSteps": ["deep_link_profile"],
      "assertions": [
        { "type": "assertWithAI", "prompt": "The user's profile information (name, phone) is displayed" },
        { "type": "assertWithAI", "prompt": "Menu items like Payment Methods, Notifications, Help are visible" }
      ],
      "hierarchyAnalysis": {
        "expectedTextNodes": ["My Profile", "Payment Methods", "Notifications", "Help", "About"],
        "thresholdOverrides": null
      }
    },
    "transactions": {
      "navigationSteps": ["deep_link_transactions"],
      "assertions": [
        { "type": "assertWithAI", "prompt": "A list of transaction entries is visible with dates and amounts" }
      ],
      "hierarchyAnalysis": {
        "expectedTextNodes": [],
        "thresholdOverrides": null
      }
    }
  }
}
